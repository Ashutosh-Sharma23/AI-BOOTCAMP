   "source": [
    "# Create a list of random numbers and print all the even numbers in the list\n",
    "\n",
    "list = [2,3,4,10,14,15,16,17,18,19,20]\n",
    "print(\"Even numbers in the list are: \", end=' ')\n",
    "for i in list:\n",
    "    if i % 2 == 0:\n",
    "        print(i, end=' ')\n",
    "\n",
    "\n"
   ]
  }
